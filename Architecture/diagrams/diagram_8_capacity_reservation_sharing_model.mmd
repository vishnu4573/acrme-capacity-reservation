    classDef crowBox fill:#00897B,stroke:#00695C,stroke-width:2px,color:#FFF
    classDef acctBox fill:#FFF8E1,stroke:#FFB300,stroke-width:3px,color:#000
    classDef tiersBox fill:#F3F2F1,stroke:#8A8886,stroke-width:2px,color:#000
    classDef constraintsBox fill:#FCE4EC,stroke:#C2185B,stroke-width:2px,color:#000

