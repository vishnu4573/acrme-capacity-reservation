graph TB
    TITLE["<b>ACRME — Capacity Reservation Sharing Model (Provider / Consumer)</b><br/><span style='font-size:12px'>Same Region + Same Availability Zone only (CAP-013) · Example: Prod West US 3, Zone 1</span>"]

    subgraph PROVIDER["🟦 PROVIDER SUBSCRIPTION — owns the shared reservation"]
        direction TB
        PSUB["☁️ Subscription<br/><b>sub-jda-cld-core-01</b>"]
        PRG["📦 Resource Group<br/><b>rg-odcr-prod-wus3-01</b>"]
        PSUB --> PRG
        subgraph PCRG["🔷 CRG — crg-pr-wus3-az1 (Zone 1)"]
            PRES["📊 <b>res-pr-wus3-az1-StandardD16sv5-001</b><br/>SKU: Standard_D16s_v5<br/>Reserved Quantity: <b>100</b><br/>Sharing: <b>ENABLED</b>"]
        end
        PRG --> PCRG
    end

    C1["🟩 <b>CONSUMER 1</b><br/>Subscription: sub-jda-cld-app-01<br/>🖥️ 15 × Standard_D16s_v5 VMs (Zone 1)<br/>Own quota required ✓ (QUA-013)"]
    C2["🟩 <b>CONSUMER 2</b><br/>Subscription: sub-jda-cld-app-02<br/>🖥️ 22 × Standard_D16s_v5 VMs (Zone 1)<br/>Own quota required ✓ (QUA-013)"]
    C3["🟩 <b>CONSUMER 3</b><br/>Subscription: sub-jda-cld-app-03<br/>🖥️ 18 × Standard_D16s_v5 VMs (Zone 1)<br/>Own quota required ✓ (QUA-013)"]

    CROW["🟢 CONSUMER SUBSCRIPTIONS — consume shared capacity, do NOT own it · each needs its own quota (QUA-013)"]

    PRES -->|"shares capacity<br/>(authorized consumer)"| C1
    PRES -->|"shares capacity<br/>(authorized consumer)"| C2
    PRES -->|"shares capacity<br/>(authorized consumer)"| C3

    C1 -.->|"VMs associated<br/>to provider's CRG"| PCRG
    C2 -.->|"VMs associated<br/>to provider's CRG"| PCRG
    C3 -.->|"VMs associated<br/>to provider's CRG"| PCRG

    CROW -.- C1
    CROW -.- C2
    CROW -.- C3

    ACCT["💰 <b>Consumption Accounting (CAP-015 — No Double Counting)</b><br/>─────────────────────────────<br/>Provider reserves:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;100<br/>Consumer-1 allocated:&nbsp;&nbsp;&nbsp;&nbsp;15<br/>Consumer-2 allocated:&nbsp;&nbsp;&nbsp;&nbsp;22<br/>Consumer-3 allocated:&nbsp;&nbsp;&nbsp;&nbsp;18<br/>─────────────────────────────<br/><b>Total allocated:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;55</b>&nbsp;&nbsp;(counted ONCE at provider)<br/><b>Remaining available:&nbsp;&nbsp;&nbsp;45</b><br/><i>Authorization to consume ≠ allocated capacity</i>"]

    TIERS["🏷️ <b>Sharing Tiers</b><br/>─────────────────────────────<br/><b>Tier 1:</b> Single subscription owns + consumes (no sharing)<br/><b>Tier 2 (Preview):</b> Provider shares with up to ~100 consumers, same region + AZ<br/><b>Tier 3 (Preview):</b> Provider can forcibly disassociate consumer VMs<br/>(needs consumer credential model — G-14, undesigned)"]

    CONSTRAINTS["⚠️ <b>CONSTRAINTS</b> &nbsp;·&nbsp; 📍 Same Region + Same AZ only (CAP-011, CAP-013) &nbsp;·&nbsp; 📊 Each consumer needs own quota (QUA-013) &nbsp;·&nbsp; 👁️ Sharing state tracked: provider, consumers, consuming VMs, consumed/remaining (CAP-014) &nbsp;·&nbsp; 🧪 Preview feature — record as Observed, not SLA"]

    TITLE --> PROVIDER
    C1 --> ACCT
    C3 --> TIERS
    ACCT --> CONSTRAINTS
    TIERS --> CONSTRAINTS

