flowchart TB
    STATUS["Standard: environment_v2.yaml (effective 2026-10-23; owner-confirmed 2026-11-17) · baseline v4.0.2<br/>environment.yaml is historical what-if only"]

    subgraph Profile["Standard environment profile: dedicated subscriptions per environment and domain group"]
        direction LR
        subgraph TMS["Domain group: TMS"]
            TMSProd["Prod compute + resource subscriptions"]
            TMSCVAL["CVAL compute + resource subscriptions"]
            TMSDR["DR compute + resource subscriptions"]
            TMSProd -. "No production capacity sharing" .- TMSDR
            TMSCVAL -. "Same-domain, same-region CRG sharing" .- TMSDR
        end
        subgraph WMS["Domain group: WMS"]
            WMSProd["Prod compute + resource subscriptions"]
            WMSCVAL["CVAL compute + resource subscriptions"]
            WMSDR["DR compute + resource subscriptions"]
            WMSCVAL -. "Same-domain, same-region CRG sharing" .- WMSDR
        end
        subgraph Other["Domain group: Domain_group_n"]
            OtherProd["Prod compute + resource subscriptions"]
            OtherCVAL["CVAL compute + resource subscriptions"]
            OtherDR["DR compute + resource subscriptions"]
            OtherCVAL -. "Same-domain, same-region CRG sharing" .- OtherDR
        end
    end

    subgraph DRReady["DR readiness: completed before a disaster"]
        Setup["Provision dedicated DR subscriptions and clusters"] --> RunReduced["Run at configurable reduced capacity"]
        RunReduced --> Test["Test DR environment"]
        Test --> Cert["Certify readiness after successful tests\nRetain test results and certification record"]
        Cert --> Ready["DR ready"]
        Ready -->|"Approved DR declaration"| Scale["Scale existing DR clusters to approved recovery requirement"]
        Scale --> Validate["Validate capacity and both quota caps"]
    end

    subgraph Capacity["Capacity reservation policy"]
        Foundation["Dedicated DR Foundation CRGs + pre-staged quota\nAlways present; bootstrap does not depend on sharing"]
        Release["Approved DR declaration + CVAL capacity release"]
        Shared["CVAL/DR shared CRG extension\nPreview; provider ownership pending"]
        Gate["Validate exact SKU, region and physical zone alignment\nProvider quota + consumer family/regional quota"]
        Count["Count shared capacity once\nNever share across domains or regions"]
        Fallback["If sharing unavailable: reservation in deploying subscription"]
        Foundation --> Scale
        Release --> Shared --> Gate --> Count
        Gate -. "Sharing unavailable or not approved" .-> Fallback
        Shared -. "Requires POC-001, POC-003, POC-012 and DEP-001" .-> Gate
    end

    subgraph Geography["Geography and DR placement"]
        US["US: three-region model"]
        EU["Europe: two-region model\nCVAL and DR co-located"]
        AU["Australia: two-region model\nCVAL and DR co-located"]
        APAC["Asia Pacific: two-region model\nCVAL and DR co-located"]
        ME["Middle East: Prod + CVAL local"]
        MEDR["DR in weighted-selected Europe Standard region\nDedicated reserved capacity"]
        ME --> MEDR
    end

    subgraph Compute["Standard compute subscription limits and rollout"]
        Limits["16 total cluster slots; 8 active\n8 blue + 8 green slots"]
        Rollout["Blue/green rollout checks current + replacement overlap"]
        DRCost["Pre-running DR clusters count toward total and active limits"]
        Headroom["DR use of rollout headroom: policy pending"]
        Limits --> Rollout
        Limits --> DRCost --> Headroom
    end

    subgraph ScaleOut["Subscription scale-out"]
        ComputeLimit["Compute subscription limit or insufficient rollout headroom"] --> NewCompute["Provision another standard compute subscription"]
        ResourceLimit["Any resource subscription-level limit"] --> NewResource["Provision another standard resource subscription"]
    end

    STATUS --> TMSProd
    STATUS --> Setup

    classDef prod fill:#dceef8,stroke:#24617b,color:#142f3a
    classDef cval fill:#e8f4dc,stroke:#547c32,color:#24371b
    classDef dr fill:#fff0cc,stroke:#9b6a00,color:#3e2c00
    classDef control fill:#f3f3f3,stroke:#666,color:#222
    classDef status fill:#FFF3E0,stroke:#E65100,stroke-width:2px,color:#111
    class TMSProd,WMSProd,OtherProd prod
    class TMSCVAL,WMSCVAL,OtherCVAL cval
    class TMSDR,WMSDR,OtherDR,Foundation,Shared,MEDR dr
    class Setup,RunReduced,Test,Cert,Ready,Scale,Validate,Gate,Count,Fallback,Limits,Rollout,DRCost,Headroom,ComputeLimit,NewCompute,ResourceLimit,NewResource control
    class STATUS status
