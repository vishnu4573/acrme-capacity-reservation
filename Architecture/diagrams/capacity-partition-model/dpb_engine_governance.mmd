        B_NS["<b>CVAL Subscription</b>"]
        B_DS["<b>DR Subscription</b>"]
        B_CC["🔗 CVAL/DR Shared CRG Set<br/><i>Shared within THIS domain only</i>"]
        B_NS --- B_CC
        B_DS --- B_CC
    end

    subgraph DGN["Domain Group N"]
        direction TB
        N_PS["<b>Prod Subscription</b>"]
        N_PC["🔒 Prod CRG Set"]
