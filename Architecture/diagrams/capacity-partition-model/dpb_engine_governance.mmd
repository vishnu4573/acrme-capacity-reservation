        N_DS --- N_CC
    end

    subgraph DGF["Domain Group: Foundation Services — wl-fnd"]
        direction TB
        F_PS["<b>Prod Subscription</b>"]
        F_PC["🔒 Prod CRG Set"]
        F_PS --- F_PC

        F_CVAL_INFO["<b>Standing CVAL Capacity</b><br/>IAM · APIM · Kafka · Control Plane<br/><i>Always running in DR region R_d</i><br/><i>Ready before DR declaration</i>"]
        F_CS["<b>Foundation CVAL Subscription</b>"]
        F_CVAL_CRG["🛡️ CVAL Foundation CRG Set<br/><code>crg-cvalf-R-*</code><br/><i>Dedicated bootstrap ·</i><br/><i>pre-staged quota</i><br/><i>Never shared with DR</i><br/>ENV-005 · DR-007 · DR-021 · QUA-015"]
        F_CVAL_INFO --- F_CS
        F_CS --- F_CVAL_CRG

        F_DR_INFO["<b>Standing DR Capacity</b><br/>IAM · APIM · Kafka · Control Plane<br/><i>Always running in DR region R_d</i><br/><i>Ready before DR declaration</i>"]
        F_DS["<b>Foundation DR Subscription</b>"]
        F_DC["🛡️ DR Foundation CRG Set<br/><code>crg-drf-R-*</code><br/><i>Dedicated bootstrap ·</i><br/><i>pre-staged quota</i><br/><i>Never shared with CVAL</i><br/>ENV-005 · DR-007 · DR-021 · QUA-015"]
        F_DR_INFO --- F_DS
        F_DS --- F_DC
    end

    DPB -->|"DPB(FND,E)"| DGF

    SUB_GOV["<b>DOM-002 — Subscription Boundary</b><br/>Each D × E deploys in a<br/>distinct subscription"]
    ISO["<b>ENV-003 + DOM-004 — Isolation</b><br/>CVAL/DR sharing is domain-bounded:<br/>a shared CRG never crosses<br/>domain group boundaries<br/>Prod never shares with anyone"]

    SUB_GOV -.->|"governs"| DGA
