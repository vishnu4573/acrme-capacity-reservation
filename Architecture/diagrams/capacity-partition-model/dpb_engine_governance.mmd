flowchart TB
    CRV["<b>CRV — Customer Region Vector</b><br/><i>Customer-scoped · one per C × G</i><br/>───────────────────<br/>R_p — Prod Region<br/>R_c — CVAL Region<br/>R_d — DR Region<br/>mod — Distribution Model<br/>G — Geography<br/>ver — Policy / Engine Version<br/>───────────────────<br/><b>PLC-013 · F.11</b>"]

    CRV -->|"Required input<br/>(PLC-015 gate:<br/>CRV strictly precedes DPB)"| DPB

    DPB["<b>DPB Engine</b><br/><i>Per Domain Group D × Environment E</i><br/>───────────────────<br/>Deterministic: same CRV + policy<br/>version = identical outcome<br/>No region weighting at domain scope<br/>───────────────────<br/><b>PLC-014 · F.12</b>"]

    DPB --> DPB_BIND

    DPB_BIND["<b>DPB(D,E) resolves:</b><br/>───────────────────<br/>① Domain compute subscription/shard<br/>(DOM-002/003 · C-12)<br/>② CRG set — per CAP-025<br/>(Prod-dedicated | CVDR-shared | DRF)<br/>③ CR sizing — allocated + buffer<br/>(F.1 · F.2 · F.3)<br/>④ Zone distribution — per-domain<br/>(PLC-016 · F.9)<br/>⑤ Quota draw — central group<br/>(QUA-015 · region × VM-family)<br/>───────────────────<br/>DPB outputs the capacity envelope;<br/>it does not determine Instance Group.<br/><b>PLC-014</b>"]
    SERVICE_IG["Downstream service deployment<br/>Service Owner / Product Automation selects<br/>and registers the Instance Group using DPB context"]

    DPB -->|"DPB(A,Prod)"| DGA
    DPB -->|"DPB(A,CVAL)"| DGA
    DPB -->|"DPB(A,DR)"| DGA
    DPB -->|"DPB(B,Prod)"| DGB
    DPB -->|"DPB(B,CVAL)"| DGB
    DPB -->|"DPB(B,DR)"| DGB
    DPB -->|"DPB(N,E)"| DGN

    subgraph DGA["Domain Group A — e.g. wl-tms"]
        direction TB
        A_PS["<b>Prod Subscription</b><br/><code>sub-…-prod-wl-tms-…</code>"]
        A_PC["🔒 Prod CRG Set<br/><code>crg-pr-R-*</code><br/><i>Dedicated · never shared</i><br/>ENV-003 · CAP-023"]
        A_PS --- A_PC

        A_NS["<b>CVAL Subscription</b><br/><code>sub-…-cval-wl-tms-…</code>"]
        A_DS["<b>DR Subscription</b><br/><code>sub-…-dr-wl-tms-…</code>"]
        A_CC["🔗 CVAL/DR Shared CRG Set<br/><code>crg-cvdr-R-*</code><br/><i>Same domain and region only · Preview</i><br/><i>Provider subscription pending decision</i><br/>ENV-003 · DOM-004 · CAP-025"]
        A_NS -. "owner/consumer pending" .-> A_CC
        A_DS -. "owner/consumer pending" .-> A_CC
        A_DF["🛡️ DR Foundation CRG<br/><code>crg-drf-R-*</code><br/><i>Dedicated DR subscription · always present</i><br/><i>Pre-staged quota · independent of sharing</i><br/><i>Tested before readiness certification</i><br/>ENV-005 · DR-021"]
        A_DS --- A_DF
    end

    subgraph DGB["Domain Group B — e.g. wl-wms"]
        direction TB
        B_PS["<b>Prod Subscription</b><br/><code>sub-…-prod-wl-wms-…</code>"]
        B_PC["🔒 Prod CRG Set<br/><i>Dedicated · never shared</i>"]
        B_PS --- B_PC

        B_NS["<b>CVAL Subscription</b>"]
        B_DS["<b>DR Subscription</b>"]
        B_CC["🔗 CVAL/DR Shared CRG Set<br/><i>Same domain and region only · Preview</i><br/><i>Provider subscription pending decision</i>"]
        B_NS -. "owner/consumer pending" .-> B_CC
        B_DS -. "owner/consumer pending" .-> B_CC
        B_DF["🛡️ DR Foundation CRG<br/><i>Dedicated DR subscription · always present</i><br/><i>Pre-staged quota · independent of sharing</i><br/><i>Tested before readiness certification</i>"]
        B_DS --- B_DF
    end

    subgraph DGN["Domain Group N"]
        direction TB
        N_PS["<b>Prod Subscription</b>"]
        N_PC["🔒 Prod CRG Set"]
        N_PS --- N_PC
        N_NS["<b>CVAL Subscription</b>"]
        N_DS["<b>DR Subscription</b>"]
        N_CC["🔗 CVAL/DR Shared CRG Set<br/><i>Same domain and region only · Preview</i><br/><i>Provider subscription pending decision</i>"]
        N_NS -. "owner/consumer pending" .-> N_CC
        N_DS -. "owner/consumer pending" .-> N_CC
        N_DF["🛡️ DR Foundation CRG<br/><i>Dedicated DR subscription · always present</i><br/><i>Pre-staged quota · independent of sharing</i><br/><i>Tested before readiness certification</i>"]
        N_DS --- N_DF
    end

    DPB_BIND --> SERVICE_IG

    SUB_GOV["<b>DOM-002 — Subscription Boundary</b><br/>Each D × E has dedicated compute and resource subscriptions;<br/>compute shard registry handles scale-out"]
    ISO["<b>ENV-003 + DOM-004 — Isolation</b><br/>CVAL/DR sharing is domain-bounded:<br/>a shared CRG never crosses<br/>domain group boundaries<br/>Prod never shares with anyone"]

    SUB_GOV -.->|"governs"| DGA
    SUB_GOV -.->|"governs"| DGB
    SUB_GOV -.->|"governs"| DGN
    ISO -.->|"enforces"| DGA
    ISO -.->|"enforces"| DGB
    ISO -.->|"enforces"| DGN

    subgraph LEGEND["Legend"]
        direction LR
        L1["🔒 Red — Prod CRG<br/>Dedicated · never shared"]
        L2["🔗 Yellow — CVAL/DR Shared CRG<br/>Shared within one domain only"]
        L3["🛡️ Purple — per-domain DR Foundation CRG<br/>Dedicated DR subscription · always present"]
        L4["Blue box — Compute subscription<br/>One per domain × environment"]
        L5["Dark container — Domain Group<br/>Workload-domain grouping"]
        L6["Green box — Governance rule<br/>Cross-cutting constraint"]
    end

