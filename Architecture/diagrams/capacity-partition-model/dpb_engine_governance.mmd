    SUB_GOV -.->|"governs"| DGN
    SUB_GOV -.->|"governs"| DGF
    ISO -.->|"enforces"| DGA
    ISO -.->|"enforces"| DGB
    ISO -.->|"enforces"| DGN
    ISO -.->|"enforces"| DGF

    subgraph LEGEND["Legend"]
