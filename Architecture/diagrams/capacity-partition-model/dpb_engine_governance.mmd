flowchart TB
    CRV["<b>CRV — Customer Region Vector</b><br/><i>Customer-scoped · one per C × G</i><br/>───────────────────<br/>R_p — Prod Region<br/>R_c — CVAL Region<br/>R_d — DR Region<br/>mod — Distribution Model<br/>G — Geography<br/>ver — Policy / Engine Version<br/>───────────────────<br/><b>PLC-013 · F.11</b>"]

    CRV -->|"Required input<br/>(PLC-015 gate:<br/>CRV strictly precedes DPB)"| DPB

    DPB["<b>DPB Engine</b><br/><i>Per Domain Group D × Environment E</i><br/>───────────────────<br/>Deterministic: same CRV + policy<br/>version = identical outcome<br/>No region weighting at domain scope<br/>───────────────────<br/><b>PLC-014 · F.12</b>"]

    DPB --> DPB_BIND

    DPB_BIND["<b>DPB(D,E) resolves:</b><br/>───────────────────<br/>① ig — Instance Group subscription<br/>(DOM-002 · C-12 · shard registry)<br/>② CRG set — per CAP-025<br/>(Prod-dedicated | CVDR-shared)<br/>③ CR sizing — allocated + buffer<br/>(F.1 · F.2 · F.3)<br/>④ Zone distribution — per-domain<br/>(PLC-016 · F.9)<br/>⑤ Quota draw — central group<br/>(QUA-015 · region × VM-family)<br/>───────────────────<br/><b>PLC-014</b>"]

    DPB -->|"DPB(A,Prod)"| DGA
    DPB -->|"DPB(A,CVAL)"| DGA
    DPB -->|"DPB(A,DR)"| DGA
    DPB -->|"DPB(B,Prod)"| DGB
    DPB -->|"DPB(B,CVAL)"| DGB
    DPB -->|"DPB(B,DR)"| DGB
    DPB -->|"DPB(N,E)"| DGN

    subgraph DGA["Domain Group A — e.g. wl-tms"]
        direction TB
        A_PS["<b>Prod Subscription</b><br/><code>sub-…-prod-wl-tms-…</code>"]
        A_PC["🔒 Prod CRG Set<br/><code>crg-pr-R-*</code><br/><i>Dedicated · never shared</i><br/>ENV-003 · CAP-023"]
        A_PS --- A_PC

        A_NS["<b>CVAL Subscription</b><br/><code>sub-…-cval-wl-tms-…</code>"]
        A_DS["<b>DR Subscription</b><br/><code>sub-…-dr-wl-tms-…</code>"]
        A_CC["🔗 CVAL/DR Shared CRG Set<br/><code>crg-cvdr-R-*</code><br/><i>Shared within THIS domain only</i><br/>ENV-003 · DOM-004 · CAP-025"]
        A_NS --- A_CC
        A_DS --- A_CC
    end

    subgraph DGB["Domain Group B — e.g. wl-wms"]
        direction TB
        B_PS["<b>Prod Subscription</b><br/><code>sub-…-prod-wl-wms-…</code>"]
