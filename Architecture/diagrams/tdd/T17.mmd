flowchart TD
    ROOT[ACRME-managed Geographies<br/>region classification per HC-8 / HC-9<br/>catalogue is configurable & versioned — REG-001]

    ROOT --> US
    ROOT --> EU
    ROOT --> AU
    ROOT --> APAC
    ROOT --> ME

    subgraph US["US Geography — 3-region model"]
      direction TB
      USS["Standard (automated placement):<br/>West US 3 · Central US · Canada Central"]
      USR["Restricted (exception path only):<br/>East US 2"]
    end

    subgraph EU["Europe Geography — 2-region model + cross-geo DR destination for ME"]
      direction TB
      EUS["Standard (automated placement):<br/>Switzerland North · Sweden Central"]
      EUR["Restricted (exception path only):<br/>North Europe · West Europe"]
    end

    subgraph AU["Australia Geography — 2-region model"]
      direction TB
      AUS["Standard (automated placement):<br/>Australia East · Australia Southeast"]
    end

    subgraph APAC["Asia Pacific Geography — 2-region model"]
      direction TB
      APS["Standard (automated placement):<br/>East Asia · Southeast Asia"]
      APP["Pending confirmation:<br/>Japan East (not selectable until added to config)"]
    end

    subgraph ME["Middle East Geography — cross-geo DR model [Amended v2.4]"]
      direction TB
      MES["Standard (Prod + CVAL, co-located):<br/>UAE North · Saudi Arabia Central"]
      MEDR["DR status: OFFERED cross-geo into Europe<br/>(DR-020, PLC-010b, DEC-001 RESOLVED)"]
      MEX["DR = weighted-selected Europe Standard region<br/>(Switzerland North = default example, not fixed)"]
      MES --> MEDR --> MEX
    end

    STD["Standard Capacity Regions →<br/>eligible for automated placement of<br/>Prod, CVAL/NonProd & DR<br/>(PS scoring via HC-8 / HC-9)"]
    RES["Restricted Regions →<br/>Prod-only exception path<br/>(Scenario 2, operator approval;<br/>CVAL/DR never allowed — VR-6)"]
    COLO["2-region co-located distribution (EU · Australia · Asia Pacific):<br/>Prod in one region;<br/>CVAL + DR co-located in the other<br/>(mandatory & deterministic — PLC-010a)"]
    XGEO["Cross-geo DR (Middle East) [Amended v2.4]:<br/>Prod + CVAL co-located in a weighted-selected ME region;<br/>DR placed cross-geo in a weighted-selected Europe region<br/>(weighted model; DR-020, PLC-010b; Europe sizes DR max-not-sum, DR-017)"]

    USS -.-> STD
    EUS -.-> STD
    AUS -.-> STD
    APS -.-> STD
    MES -.-> STD
    USR -.-> RES
    EUR -.-> RES
    MEX -.-> XGEO

    EUS -.-> COLO
    AUS -.-> COLO
    APS -.-> COLO
    EUS -.-> XGEO

    NOTE["Regions are canonical examples from the Requirements Baseline v2.4 Section 6,<br/>Hard Constraints Reference and Calculation Logic Reference. Actual Azure region<br/>inventory may differ; the authoritative Standard/Restricted lists and each<br/>geography's distribution model live in PlacementPolicy (HC-8 / HC-9 / REG-001)."]
    ROOT -.-> NOTE
