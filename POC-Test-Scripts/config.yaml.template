# ============================================================================
# ACRME POC Test Suite — Configuration Template
# ----------------------------------------------------------------------------
# Copy this file to `config.yaml` and fill in every value before running the
# suite. All fields below are REQUIRED unless explicitly noted as optional.
#
#   cp config.yaml.template config.yaml
#   $EDITOR config.yaml
#
# HARD CONSTRAINT (GEOGRAPHY-AWARE, baseline REG-003 / PLC-010a / PLC-010b):
#   * three-region geography (US): regions.primary, regions.dr and
#     regions.nonprod MUST be three DISTINCT Azure regions.
#   * two-region geography (Europe / Australia / Asia Pacific):
#     Prod occupies one region; CVAL/NonProd and DR CO-LOCATE in the single
#     remaining region — so regions.dr MUST equal regions.nonprod (both differ
#     from regions.primary). This co-location is the required outcome, not an
#     error. Where DR is not offered (legacy DR_NOT_OFFERED) no DR region is
#     assigned — leave regions.dr blank.
#   * [Amended v2.4] cross-geo geography (Middle East): Prod and CVAL/NonProd
#     CO-LOCATE in a weighted-selected Middle East region (separate CRGs,
#     ENV-003) — so regions.nonprod MUST equal regions.primary; DR is placed
#     CROSS-GEO in a weighted-selected Europe region — so regions.dr MUST be
#     set and differ from regions.primary (DR-020 / PLC-010b). Middle East DR
#     is now offered into Europe (DEC-001 RESOLVED).
# Set regions.distribution_model to select the model. The config loader and
# pre-flight PF-09/PF-10 enforce the correct rule for the chosen model.
# ============================================================================

provider:
  subscription_id: ""      # Provider (capacity owner) subscription GUID
  resource_group: ""       # Provider resource group that holds the CRGs
  tenant_id: ""            # Azure AD tenant GUID

consumer:
  subscription_id: ""      # Consumer subscription GUID (shares provider CRG)
  resource_group: ""       # Consumer resource group for consumer VMs

regions:
  distribution_model: "three-region"  # "three-region" (US), "two-region" (EU/AU/APAC), or "cross-geo" (Middle East)
  dr_offered: true         # cross-geo (ME) always true — DR offered into Europe (DEC-001 RESOLVED)
  primary: ""              # production region — e.g. westus3 (3-region) / westeurope (2-region) / uaenorth (cross-geo)
  # THREE-REGION example (US):  primary: westus3   dr: canadacentral   nonprod: centralus
  # TWO-REGION example (EU):    primary: switzerlandnorth   dr: swedencentral   nonprod: swedencentral
  #   (dr MUST equal nonprod — CVAL and DR co-locate, PLC-010a)
  # CROSS-GEO example (ME):     primary: uaenorth   nonprod: uaenorth   dr: switzerlandnorth
  #   (nonprod MUST equal primary — Prod+CVAL co-locate in-geo; dr is a Europe region distinct from primary, DR-020/PLC-010b)
  dr: ""                   # 3-region: distinct from primary & nonprod. 2-region: == nonprod (blank if DR not offered). cross-geo: Europe region != primary
  nonprod: ""              # CVAL/NonProd region — must differ from primary (EXCEPT cross-geo, where nonprod == primary)

vm:
  sku: ""                  # e.g. Standard_D4s_v3
  sku_family: ""           # e.g. standardDSv3Family
  vcpus_per_instance: 4    # vCPUs per instance of the chosen SKU (used for floor maths)

crg:
  name: ""                 # Primary CRG name (will be prefixed acrme-poc- if not already)
  reservation_name: ""     # Primary capacity reservation name
  quantity: 2              # Reserved instance count in the primary CRG
  dr_crg_name: ""          # DR CRG name
  dr_reservation_name: ""  # DR capacity reservation name
  dr_quantity: 2           # Reserved instance count in the DR CRG
  dr_floor_percentage: 40  # DR floor protection percentage (engine-enforced, see POC-13)

quota_group:
  name: ""                 # Quota group name. Leave BLANK if quota groups not required.

aks:
  resource_group: ""       # AKS resource group. Leave BLANK to skip AKS tests.
  cluster_name: ""         # Existing AKS cluster name
  nodepool_name: ""        # Node pool name to create/associate (e.g. acrmepoc)

# Phase gate governs which tests are eligible to run:
#   phase1     — read/lightweight validation, no destructive DR/quota-group tests
#   phase2     — DR failover, quota group membership, engine-dependent tests
#   production — full suite including 100-consumer limit and throttle tests
phase_gate: "phase1"       # phase1 | phase2 | production

dry_run: false             # If true, commands are printed but NOT executed
timeout_seconds: 300       # Per-test / per-command timeout in seconds
